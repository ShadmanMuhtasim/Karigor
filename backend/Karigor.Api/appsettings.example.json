{
  "_comment": "TEMPLATE ONLY - do not commit real values. Copy to appsettings.json and fill in from user-secrets / environment variables.",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Jwt": {
    "Issuer": "karigor-api",
    "Audience": "karigor-client",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "Key": ""
  },

  "SslCommerz": {
    "StoreId": "",
    "StorePassword": "",
    "IsSandbox": true,
    "AppBaseUrl": "http://localhost:5253",
    "ClientBaseUrl": "http://localhost:5173"
  },

  "RateLimiting": {
    "_comment": "Permits-per-window for each named limiter policy. Adjust to match your deployment.",
    "WindowSeconds": 60,
    "Policies": {
      "AuthLimiter": {
        "PermitLimit": 10,
        "WindowSeconds": 60
      },
      "PublicLimiter": {
        "PermitLimit": 60,
        "WindowSeconds": 60
      },
      "AuthenticatedLimiter": {
        "PermitLimit": 120,
        "WindowSeconds": 60
      }
    }
  },

  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
